{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/", "destination": "/public/login.html" },
    { "source": "/login", "destination": "/public/login.html" },
    { "source": "/dashboard", "destination": "/public/index.html" },
    { "source": "/scan", "destination": "/public/scan.html" },
    { "source": "/inventory", "destination": "/public/inventory.html" },
    { "source": "/protected-spaces", "destination": "/public/protected-spaces.html" },
    { "source": "/history", "destination": "/public/history.html" },
    { "source": "/reports", "destination": "/public/reports.html" },
    { "source": "/settings", "destination": "/public/settings.html" }
  ],

  "redirects": [
    { "source": "/index", "destination": "/public/dashboard.html", "permanent": true },
    { "source": "/home", "destination": "/public/dashboard.html", "permanent": true },
    { "source": "/signin", "destination": "/public/login.html", "permanent": true },
    { "source": "/sign-in", "destination": "/public/login.html", "permanent": true }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/public/login.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/public/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/public/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}